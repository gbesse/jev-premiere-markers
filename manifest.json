{
  "manifestVersion": 5,
  "id": "com.gbesse.jev-premiere-markers",
  "name": "Jev Premiere Markers",
  "shortname": "Jev Markers",
  "version": "0.1.1",
  "main": "index.html",
  "host": { "app": "premierepro", "minVersion": "25.6.0" },
  "requiredPermissions": {
    "network": { "domains": ["https://api.typesafe.ai"] }
  },
  "entrypoints": [{
    "type": "panel",
    "id": "jevMarkers",
    "label": { "default": "Jev Review Markers" },
    "minimumSize": { "width": 320, "height": 500 },
    "maximumSize": { "width": 1600, "height": 2000 },
    "preferredDockedSize": { "width": 380, "height": 650 },
    "preferredFloatingSize": { "width": 460, "height": 720 }
  }]
}
