{
  "name": "jev-premiere-markers",
  "version": "0.1.1",
  "description": "Turn typed Jev review findings into exact, undoable Premiere timeline markers.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "npm run lint && npm run build && node scripts/check.mjs",
    "lint": "eslint src",
    "test": "node --test",
    "demo": "node scripts/demo.mjs",
    "demo:guard": "node scripts/guard-demo.mjs",
    "demo:interval": "node scripts/invalid-interval-demo.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gbesse/jev-premiere-markers.git"
  },
  "devDependencies": {
    "@adobe/eslint-plugin-premierepro": "26.5.0",
    "@adobe/premierepro": "26.5.0",
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "esbuild": "0.25.10"
  }
}
